# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=eu-north-1

# ── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET=data-mep-project

# ── API / Model ───────────────────────────────────────────────────────────────
MODEL_TYPE=cnn
DATASET=cifar10
USE_BN=true
S3_MODEL_KEY=models/cifar10_cnn_bn.pt

# ── DataLoader ────────────────────────────────────────────────────────────────
BATCH_SIZE=128
NUM_WORKERS=0
